# Public hostname, without scheme. One name only: it is also used as the
# Ingress host and certificate name.
NEXTCLOUD_TRUSTED_DOMAINS=cloud.example.com
# TLS ends at the ingress controller.
OVERWRITEPROTOCOL=https
OVERWRITECLIURL=https://cloud.example.com
# Pod network range of your cluster, so Nextcloud trusts X-Forwarded-For from
# the ingress controller. kubeadm with Flannel: 10.244.0.0/16, k3s: 10.42.0.0/16.
TRUSTED_PROXIES=10.244.0.0/16
# Keep at or below the ingress controller's request body limit.
PHP_UPLOAD_LIMIT=4G
TZ=Europe/Berlin
