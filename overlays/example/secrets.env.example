# Copy to secrets.env (git-ignored) and replace every value, for example with
#   openssl rand -base64 24
# Changing mariadb-password later does not change it inside an existing
# database; see docs/specs/004-operations.md.
mariadb-user=nextcloud
mariadb-password=
mariadb-root-password=
nextcloud-admin-user=admin
nextcloud-admin-password=
